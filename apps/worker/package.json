    "@intellirepo/contracts": "workspace:*",
    "@intellirepo/indexing": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "latest"
  }
}
