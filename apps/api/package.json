{
  "name": "@intellirepo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@intellirepo/catalog": "workspace:*",
    "@intellirepo/contracts": "workspace:*",
    "@intellirepo/documentation": "workspace:*",
    "@intellirepo/graph": "workspace:*",
    "@intellirepo/qa": "workspace:*",
    "@intellirepo/repository": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "kysely": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "latest"
  }
}
