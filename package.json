{
  "name": "intellirepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "demo:apply-change": "tsx scripts/demo/apply-change.ts",
    "demo:reset": "tsx scripts/demo/reset.ts",
    "demo:setup": "tsx scripts/demo/setup.ts",
    "dev": "turbo run dev --parallel",
    "infra:down": "podman compose down",
    "infra:up": "podman compose up -d postgres redis",
    "doctor": "pnpm --filter @intellirepo/contracts doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "node scripts/test-integration.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
