NODE_ENV=development
API_PORT=4100
WORKER_HEALTH_PORT=4101

DATABASE_URL=postgresql://intellirepo:intellirepo@localhost:5432/intellirepo
INDEXING_MODE=bullmq
REDIS_URL=redis://localhost:6379

# Optional. Required only when publishing an idempotent IntelliRepo PR comment.
GITHUB_TOKEN=

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000
OLLAMA_CONCURRENCY=1

REPOSITORY_ALLOWED_ROOTS=./examples,./.intellirepo-demo
MAX_FILE_BYTES=1048576
MAX_REPOSITORY_FILES=5000
PARSER_CONCURRENCY=4
WORKER_CONCURRENCY=2
SCAN_LEASE_DURATION_MS=30000
SCAN_HEARTBEAT_INTERVAL_MS=10000
SCAN_DISPATCH_POLL_INTERVAL_MS=1000
SCAN_RETRY_COUNT=3
SCAN_RETRY_BACKOFF_MS=1000
GRAPH_QUERY_MAX_DEPTH=4
GRAPH_QUERY_MAX_NODES=200
